// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────
enum Level {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  SUBMITTED
  ABANDONED
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_BLANK
  ESSAY
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ContentType {
  VIDEO
  FILE
  TEXT
  PDF
  AUDIO
  IMAGE
  LINK
}

// ─── Models ────────────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  username      String        @unique
  password      String
  name          String?
  bio           String?
  role          Role          @default(STUDENT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  teachingCourses  Course[]      @relation("TeacherCourses")
  studentEnrollments Enrollment[] @relation("StudentEnrollments")
  teachingEnrollments Enrollment[] @relation("TeacherEnrollments")
  examSessions  ExamSession[]
  notes         Note[]
  payments      Payment[]
  assignedExams Exam[]        @relation("ExamAssignedStudents")
  examsCreated  Exam[]        @relation("TeacherExams")
  savedResults SavedResult[] 
  savedTips     TipSave[]      // ✅ اضافه شد - رابطه با TipSave

  @@map("users")
}

model Course {
  id            String         @id @default(cuid())
  title         String
  description   String?
  language      String         @default("English")
  level         Level          @default(BEGINNER)
  price         Float          @default(0)
  isPublished   Boolean        @default(false)
  autoEnroll    Boolean        @default(true)
  promoVideoUrl String?
  thumbnailUrl  String?
  materials     String?        // JSON String
  teacherId     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  teacher       User           @relation("TeacherCourses", fields: [teacherId], references: [id])
  enrollments   Enrollment[]
  contents      CourseContent[]
  exams         Exam[]
  payments      Payment[]

  @@map("courses")
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  teacherId String
  createdAt DateTime @default(now())
  isPaid    Boolean  @default(false)

  student   User     @relation("StudentEnrollments", fields: [studentId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   User     @relation("TeacherEnrollments", fields: [teacherId], references: [id])

  @@unique([studentId, courseId])
  @@map("enrollments")
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  amount    Float
  cardLast4 String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])

  @@map("payments")
}

model Exam {
  id               String        @id @default(cuid())
  title            String
  description      String?
  duration         Int
  startDate        DateTime
  endDate          DateTime
  level            String        @default("MEDIUM")
  audioUrl         String?
  passageText      String?
  isPublic         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  courseId         String?
  teacherId        String?

  course           Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher          User?         @relation("TeacherExams", fields: [teacherId], references: [id])
  questions        Question[]
  sessions         ExamSession[]
  assignedStudents User[]        @relation("ExamAssignedStudents")

  @@map("exams")
}

model Question {
  id            String       @id @default(cuid())
  examId        String
  questionText  String
  type          QuestionType @default(MULTIPLE_CHOICE)
  options       String?      // JSON String
  correctAnswer String
  section       String       @default("general")
  order         Int          @default(0)
  difficulty    Difficulty   @default(MEDIUM)
  explanation   String?
  createdAt     DateTime     @default(now())

  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers       Answer[]

  @@map("questions")
}

model ExamSession {
  id             String        @id @default(cuid())
  studentId      String
  examId         String
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  score          Float?
  totalCorrect   Int?
  totalQuestions Int?
  status         SessionStatus @default(IN_PROGRESS)

  student        User          @relation(fields: [studentId], references: [id])
  exam           Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers        Answer[]

  @@map("exam_sessions")
}

model Answer {
  id             String      @id @default(cuid())
  sessionId      String
  questionId     String
  selectedOption String?
  isCorrect      Boolean     @default(false)
  createdAt      DateTime    @default(now())

  session        ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@map("answers")
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("")
  content   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@map("notes")
}

model CourseContent {
  id        String      @id @default(cuid())
  courseId  String
  title     String
  type      ContentType
  url       String?     // برای VIDEO و FILE
  text      String?     // برای TEXT
  order     Int         @default(0)
  isFree    Boolean     @default(false)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_contents")
}
// مدل سوالات آزمون تعیین سطح
model PlacementQuestion {
  id            String   @id @default(cuid())
  testId        String   // شناسه آزمون (مثلاً "placement_main")
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("placement_questions")
}
model DailyTip {
  id        String   @id @default(cuid())
  content   String   // @db.Text رو حذف کردیم چون SQLite پشتیبانی نمی‌کنه
  date      DateTime @unique @default(now())
  createdAt DateTime @default(now())
  saves     TipSave[]

  @@map("daily_tips")
}

model TipSave {
  id        String   @id @default(cuid())
  userId    String
  tipId     String
  savedAt   DateTime @default(now())
  note      String?  // @db.Text رو حذف کردیم

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tip       DailyTip @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@unique([userId, tipId])
  @@map("tip_saves")
}
// به انتهای فایل schema.prisma اضافه کن
model SavedResult {
  id             String   @id @default(cuid())
  userId         String
  examId         String
  examTitle      String
  score          Float
  totalCorrect   Int
  totalQuestions Int
  completedAt    DateTime
  answers        String   // JSON string
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@map("saved_results")
}